{
  "name": "@jaxxstorm/opencode-aperture",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Lee Briggs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaxxstorm/opencode-aperture.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "description": "Route OpenCode native ChatGPT subscription requests through a trusted Aperture gateway",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": ["dist/index.js", "LICENSE", "README.md", "docs/"],
  "scripts": {
    "test": "bun test",
    "build": "bun build ./src/index.ts --target bun --outdir ./dist",
    "pack": "bun run build && npm pack --ignore-scripts",
    "test:package": "bun scripts/verify-package.ts",
    "test:routing": "bun scripts/probe-routing.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
