{
  "name": "@jaxxstorm/opencode-aperture",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Lee Briggs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaxxstorm/opencode-aperture.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "description": "Discover Aperture providers in OpenCode with gateway-managed authentication and explicit credential forwarding",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": ["dist/index.js", "dist/bridge-worker.js", "dist/tui.js", "LICENSE", "README.md", "docs/"],
  "scripts": {
    "test": "bun test",
    "build": "bun build ./src/index.ts ./src/bridge-worker.ts ./src/tui.ts --target bun --outdir dist --external @jaxxstorm/bun-tailscale-bridge",
    "pack": "bun run build && npm pack --ignore-scripts",
    "test:package": "bun scripts/verify-package.ts",
    "test:routing": "bun scripts/probe-routing.ts",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@jaxxstorm/bun-tailscale-bridge": "0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
